# Copy to .dev.vars for local `npm run dev`. Never commit the real file.
# On Cloudflare, "Deploy to Cloudflare" / Workers Builds prompt for these values;
# afterwards use `wrangler secret put NAME` or the dashboard (Settings -> Variables and Secrets).

# From @BotFather (required)
TELEGRAM_BOT_TOKEN=

# OpenRouter key from https://openrouter.ai/keys (optional here: it can be set later from /admin in the bot)
AI_API_KEY=

# Your numeric Telegram id (optional). Leave empty and send `/claim <bot token>` to the bot instead.
# Several ids are allowed: 123456, 789012
ADMIN_USER_ID=
