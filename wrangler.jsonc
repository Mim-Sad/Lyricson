{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lyricson",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEFAULT_TARGET_LANG": "fa",
    "DAILY_TRANSLATION_LIMIT": "40",
    "AI_PROVIDER": "openrouter",
    "AI_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_MODEL": "google/gemini-3.8-flash"
  },
  // No database_id on purpose: Cloudflare creates the D1 database on the first
  // deploy (automatic provisioning) and the Worker builds its own tables.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lyricson"
    }
  ],
  // Self-healing tick: re-registers the webhook if it drifted and trims expired cache rows.
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
