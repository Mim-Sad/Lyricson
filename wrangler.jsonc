{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lyricson",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEFAULT_TARGET_LANG": "fa",
    "DAILY_TRANSLATION_LIMIT": "40",
    "AI_PROVIDER": "openrouter",
    "AI_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_MODEL": "google/gemini-3.8-flash"
  },
  // The database was created by the first deploy (automatic provisioning). Its id
  // is pinned here because re-deploys from git fail to re-attach it without one.
  // Forking to another account? Delete database_id to have a new D1 created.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lyricson",
      "database_id": "a2a59b9b-8f54-4968-950a-01dc4b248b7f"
    }
  ],
  // Self-healing tick: re-registers the webhook if it drifted and trims expired cache rows.
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
